# ---------------------------------------------------------------------------
# DipDector configuration. Copy to `.env` and fill in. NEVER commit `.env`.
#
# For the scheduled GitHub Actions run these are repository Secrets instead
# (Settings -> Secrets and variables -> Actions), with the same names.
# ---------------------------------------------------------------------------

# Where alerts go.
ALERT_EMAIL=you@example.com

# --- Email delivery --------------------------------------------------------
# console = print instead of sending (default, safe)
# resend  = Resend's HTTP API — recommended
# smtp    = Gmail or any SMTP server
#
# Start on console. Confirm the text looks right, then switch.
EMAIL_PROVIDER=console

# --- Resend (recommended) --------------------------------------------------
# A transactional email service: the mail arrives from the tool's own identity
# instead of your personal account, and setup is one API key — no app
# password, no SMTP ports. Free tier is 3,000/month; this sends a handful.
#
# Sign up at resend.com USING THE SAME ADDRESS AS ALERT_EMAIL above. Without a
# verified domain you send from onboarding@resend.dev, which only delivers to
# the address on the Resend account — fine here, since that address is you.
RESEND_API_KEY=

# Optional. Defaults to "DipDector <onboarding@resend.dev>", which needs no
# domain. Only set this if you have verified your own domain in Resend.
RESEND_FROM=

# --- Gmail SMTP (alternative) ----------------------------------------------
# Works, but fiddlier: needs 2-Step Verification, an App Password, and it
# sends from your personal address. SMTP_PASSWORD must be an APP PASSWORD.
# Google Account -> Security -> 2-Step Verification -> App passwords -> Mail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_SENDER=you@gmail.com

# --- Where the reports are published ---------------------------------------
# The public base URL of the report site. The alert email links to pages under
# it, so without this the email carries relative paths and nothing is
# clickable. For GitHub Pages this is https://<user>.github.io/<repo>.
#
# The workflow derives this automatically, so it is only needed for local runs.
SITE_BASE_URL=https://you.github.io/dipdector

# --- Cause analysis (optional) ---------------------------------------------
# Your Claude Console API key. Without it the app still detects and emails
# declines; it just reports "cause not determined" instead of explaining why.
# It only runs on days something actually fires, so it costs a few cents a
# month rather than a few cents a day.
ANTHROPIC_API_KEY=

# Which model does the cause analysis. Defaults to claude-sonnet-5.
# Set claude-opus-5 for deeper analysis at a higher per-call cost.
DIPDECTOR_MODEL=claude-sonnet-5

# --- Paid data (optional, leave blank) -------------------------------------
# If set, replaces both the free price feed and the free news feed.
EODHD_API_KEY=
