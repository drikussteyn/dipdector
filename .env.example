# ---------------------------------------------------------------------------
# DipDector configuration. Copy to `.env` and fill in. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Where alerts go.
ALERT_EMAIL=you@example.com

# --- Email delivery --------------------------------------------------------
# console = print only (default, safe). smtp = Gmail or any SMTP. resend = API.
EMAIL_PROVIDER=console

# Gmail SMTP. SMTP_PASSWORD must be an APP PASSWORD, never your real password.
# Google Account -> Security -> 2-Step Verification -> App passwords -> Mail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
SMTP_SENDER=you@gmail.com

# --- Cause analysis (optional) ---------------------------------------------
# Without this the app still detects and emails declines; it just reports
# "cause not determined" instead of explaining why. Costs a few cents a month
# because it only runs on days something actually fires.
ANTHROPIC_API_KEY=

# --- Paid data (optional, leave blank) -------------------------------------
# If set, replaces both the free price feed and the free news feed.
EODHD_API_KEY=
